<?xml version="1.0" encoding="utf-8"?>
<!-- Written by `./build.sh generate`, the settings are in binding.json -->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <PackageId>Glutinum.DateFns</PackageId>
        <Description>Fable bindings for date-fns, generated by Glutinum</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <FablePackageType>binding</FablePackageType>
        <PackageTags>fable-javascript;fable-binding</PackageTags>
        <ChangelogFile>CHANGELOG.md</ChangelogFile>
        <NoWarn>$(NoWarn);FS0044</NoWarn>
        <NpmDependencies>
            <NpmPackage Name="date-fns" Version="&gt;= 4.4.0 &lt; 5.0.0" />
        </NpmDependencies>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <Compile Include="Glutinum.DateFns.fs" />
        <!-- <Compile Include="Glutinum.DateFns.Extensions.fs" /> -->
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="EasyBuild.PackageReleaseNotes.Tasks" />
        <PackageReference Include="Fable.Core" />
        <PackageReference Include="Fable.Package.SDK" />
        <PackageReference Include="Glutinum.Types" />
    </ItemGroup>
</Project>
