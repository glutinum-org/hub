<?xml version="1.0" encoding="utf-8"?>
<!-- Written by `./build.sh generate`, the settings are in binding.json -->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <PackageId>Glutinum.Express</PackageId>
        <Description>Fable bindings for express, generated by Glutinum</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <FablePackageType>binding</FablePackageType>
        <PackageTags>fable-javascript;fable-binding</PackageTags>
        <ChangelogFile>CHANGELOG.md</ChangelogFile>
        <NoWarn>$(NoWarn);FS0044</NoWarn>
        <NpmDependencies>
            <NpmPackage Name="express" Version="&gt;= 5.2.1 &lt; 6.0.0" />
        </NpmDependencies>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <Compile Include="Glutinum.Express.fs" />
        <Compile Include="Glutinum.Express.Extensions.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="EasyBuild.PackageReleaseNotes.Tasks" />
        <PackageReference Include="Fable.Core" />
        <PackageReference Include="Fable.Package.SDK" />
        <PackageReference Include="Glutinum.Node" />
        <PackageReference Include="Glutinum.Types" />
    </ItemGroup>
</Project>
