<?xml version="1.0" encoding="utf-8"?>
<!-- Written by `./build.sh generate`, the settings are in binding.json -->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <PackageId>Glutinum.Yargs</PackageId>
        <Description>Fable bindings for yargs, generated by Glutinum</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <FablePackageType>library</FablePackageType>
        <PackageTags>fable-javascript</PackageTags>
        <ChangelogFile>CHANGELOG.md</ChangelogFile>
        <NoWarn>$(NoWarn);FS0044</NoWarn>
        <NpmDependencies>
            <NpmPackage Name="yargs" Version="&gt;= 18.1.0 &lt; 19.0.0" />
        </NpmDependencies>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <Compile Include="Glutinum.Yargs.fs" />
        <Compile Include="Glutinum.Yargs.Extensions.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="EasyBuild.PackageReleaseNotes.Tasks" />
        <PackageReference Include="Fable.Core" />
        <PackageReference Include="Fable.Package.SDK" />
        <PackageReference Include="Glutinum.Types" />
    </ItemGroup>
</Project>
